# Supabase → Project Settings → API
# Project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The publishable / anon key (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Featherless.ai: the LLM engine behind "Write with AI" (featherless.ai → Account → API keys)
FEATHERLESS_API_KEY=
# Any chat model on Featherless (Hugging Face id); default below
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Research workflow (see n8n/README.md)
# The n8n Webhook node's Production URL
N8N_RESEARCH_WEBHOOK_URL=
# Long random string; the same value goes into the n8n Config node (webhookSecret)
N8N_WEBHOOK_SECRET=
# Optional: URLs per user per 24 h (default 50)
# RESEARCH_LIMIT_PER_DAY=50

# Not used yet (CRM push, invitations)
# SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=
# RESEND_API_KEY=

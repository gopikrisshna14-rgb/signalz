# ─────────────────────────────────────────────────────────────────────────────
# Signalz (beta). Every variable is optional for `npm run dev`: without them the
# app runs on in-memory demo data with "Continue with demo account".
# Copy to .env.local for local development; set them in Vercel → Settings →
# Environment Variables for deployments.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app, without trailing slash. Used for Apify callbacks and
# invite links. On Vercel it falls back to VERCEL_URL (fine for previews).
APP_URL=http://localhost:3000

# ── Open test mode ───────────────────────────────────────────────────────────
# While unset, there is NO sign-in: every visitor uses the demo account and the
# demo workspace. Set to true to require sign-in (then set AUTH_SECRET, Redis, …).
BETA_REQUIRE_LOGIN=

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Required in production with Redis. Generate: `openssl rand -base64 32`
AUTH_SECRET=
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client
# Redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft: entra.microsoft.com → App registrations → New registration
# Redirect URI (Web): {APP_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0 (or .../common/v2.0 for any tenant)
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Show "Continue with demo account" (default: true in development, false otherwise)
BETA_DEMO_LOGIN=

# ── Storage: Vercel → Storage → Upstash for Redis adds these automatically ─────
KV_REST_API_URL=
KV_REST_API_TOKEN=
# …or, if you created the database on upstash.com yourself:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Claude (optional: without it the rules classifier and templates are used) ─
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Apify (console.apify.com → Settings → API & Integrations) ────────────────
APIFY_TOKEN=
# Long random string; signs the callback URLs. `openssl rand -hex 32`
APIFY_WEBHOOK_SECRET=
# Actor IDs as owner/name. Defaults are used for the three required ones.
APIFY_JOBS_ACTOR_ID=bebity/linkedin-jobs-scraper
APIFY_PROFILE_ACTOR_ID=dev_fusion/linkedin-profile-scraper
APIFY_COMPANY_ACTOR_ID=automation-lab/linkedin-company-scraper
# Optional actors: they only run when set
APIFY_EMPLOYEES_ACTOR_ID=
APIFY_POSTS_ACTOR_ID=
APIFY_STEPSTONE_ACTOR_ID=
# Optional: exact actor input as JSON with {{url}}, "{{urls}}", {{keywords}}, {{location}}, "{{days}}"
# e.g. APIFY_PROFILE_INPUT={"profileUrls":"{{urls}}"}
# APIFY_JOBS_INPUT=
# APIFY_PROFILE_INPUT=
# APIFY_COMPANY_INPUT=

# ── Cron, encryption, limits ─────────────────────────────────────────────────
# Vercel Cron sends it as a Bearer token. `openssl rand -hex 32`
CRON_SECRET=
# Encrypts the HubSpot token (AES-256-GCM). Any long random string.
ENCRYPTION_KEY=
# Research URLs per user per day
RESEARCH_LIMIT_PER_DAY=50
